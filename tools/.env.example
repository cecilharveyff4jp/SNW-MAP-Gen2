# これをコピーして tools\.env を作り、実際の値を入れる（.env は git 管理外／チャットに貼らない）。
#
#   copy tools\.env.example tools\.env
#   メモ帳などで tools\.env を開いてトークンを貼る
#
# CF_API_TOKEN … Cloudflare の APIトークン。権限は Account → D1 → Edit だけでよい。
#                発行: Cloudflare ダッシュボード → My Profile → API Tokens → Create Token
CF_API_TOKEN=ここにトークン

# 以下は任意（既定値で動く）
# CF_ACCOUNT_ID=省略可（トークンから自動取得）
# CF_DATABASE_ID=360d346e-e617-4129-8910-0820420b5b0b
